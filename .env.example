DATABASE_URL=postgres://qia:qia@localhost:5434/qia
BETTER_AUTH_SECRET=troque-por-um-segredo
MASTER_SESSION_SECRET=troque-por-outro-segredo
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# provider da análise de ciclos: anthropic (default) ou openai
ANALYSIS_PROVIDER=anthropic
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=re_...
# remetente dos emails transacionais (recuperação de senha); sem domínio verificado, usa onboarding@resend.dev
EMAIL_FROM="QIA <no-reply@qia.app>"
# billing (Asaas) — sandbox por padrão; troque ASAAS_BASE_URL pra api.asaas.com/v3 em produção
ASAAS_API_KEY=$aact_hmlg_...
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# secret compartilhado, configurado também no cadastro do webhook no Asaas (authToken)
ASAAS_WEBHOOK_SECRET=troque-por-um-segredo
